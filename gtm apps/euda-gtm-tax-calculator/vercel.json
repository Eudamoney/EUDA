{
    "cleanUrls": true,
    "rewrites": [
        {
            "source": "/tax-calculator/assets/(.*)",
            "destination": "/assets/$1"
        },
        {
            "source": "/tax-calculator",
            "destination": "/"
        },
        {
            "source": "/tax-calculator/(spain|uk)",
            "destination": "/"
        },
        {
            "source": "/tax-calculator/(spain|uk)/(.*)",
            "destination": "/"
        },
        {
            "source": "/tax-calculator/(.*)",
            "destination": "/$1"
        }
    ]
}
